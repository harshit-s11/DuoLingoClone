  "components": {
    "schemas": {
      "AbandonAttemptResponse": {
        "properties": {
          "attempt_id": {
            "type": "integer",
            "title": "Attempt Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "attempt_id",
          "status"
        ],
        "title": "AbandonAttemptResponse"
      },
      "AchievementItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "badge_icon": {
            "type": "string",
            "title": "Badge Icon"
          },
          "target_value": {
            "type": "integer",
            "title": "Target Value"
          },
          "current_value": {
            "type": "integer",
            "title": "Current Value"
          },
          "is_unlocked": {
            "type": "boolean",
            "title": "Is Unlocked"
          },
          "unlocked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unlocked At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "description",
          "badge_icon",
          "target_value",
          "current_value",
          "is_unlocked"
        ],
        "title": "AchievementItem"
      },
      "ActivityItem": {
        "properties": {
          "activity_date": {
            "type": "string",
            "title": "Activity Date"
          },
          "xp_earned": {
            "type": "integer",
            "title": "Xp Earned"
          },
          "lessons_completed": {
            "type": "integer",
            "title": "Lessons Completed"
          }
        },
        "type": "object",
        "required": [
          "activity_date",
          "xp_earned",
          "lessons_completed"
        ],
        "title": "ActivityItem"
      },
      "AdvanceDayRequest": {
        "properties": {
          "days": {
            "type": "integer",
            "title": "Days",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AdvanceDayRequest"
      },
      "AdvanceDayResponse": {
        "properties": {
          "date_offset_days": {
            "type": "integer",
            "title": "Date Offset Days"
          },
          "logical_now": {
            "type": "string",
            "title": "Logical Now"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date_offset_days",
          "logical_now"
        ],
        "title": "AdvanceDayResponse"
      },
      "CheckAnswerRequest": {
        "properties": {
          "exercise_id": {
            "type": "integer",
            "title": "Exercise Id"
          },
          "user_answer": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "User Answer"
          },
          "answer": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "exercise_id"
        ],
        "title": "CheckAnswerRequest"
      },
      "CheckAnswerResponse": {
        "properties": {
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "correct": {
            "anyOf": [
              {
                "type": "boolean"
