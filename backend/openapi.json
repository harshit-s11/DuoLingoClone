        "type": "object",
        "required": [
          "date_offset_days",
          "logical_now"
        ],
        "title": "AdvanceDayResponse"
      },
      "CheckAnswerRequest": {
        "properties": {
          "exercise_id": {
            "type": "integer",
            "title": "Exercise Id"
          },
          "user_answer": {
            "title": "User Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
