            "type": "string",
            "title": "Badge Icon"
          },
          "target_value": {
            "type": "integer",
            "title": "Target Value"
          },
          "current_value": {
            "type": "integer",
            "title": "Current Value"
          },
          "is_unlocked": {
            "type": "boolean",
            "title": "Is Unlocked"
          },
          "unlocked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unlocked At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "description",
          "badge_icon",
          "target_value",
          "current_value",
          "is_unlocked"
        ],
        "title": "AchievementItem"
      },
      "ActivityItem": {
        "properties": {
          "activity_date": {
            "type": "string",
            "title": "Activity Date"
          },
          "xp_earned": {
            "type": "integer",
            "title": "Xp Earned"
          },
          "lessons_completed": {
            "type": "integer",
            "title": "Lessons Completed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activity_date",
          "xp_earned",
          "lessons_completed"
        ],
        "title": "ActivityItem"
      },
      "AdvanceDayRequest": {
        "properties": {
          "days": {
            "type": "integer",
            "title": "Days",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AdvanceDayRequest"
      },
